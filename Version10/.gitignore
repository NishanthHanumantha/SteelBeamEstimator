# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
*.pem

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Logs and local run artifacts
*.log
*.bak
run_*.txt

# Generated pipeline outputs (regenerated by runners)
data/output/**
!data/output/.gitkeep
# Keep Version10 QA diagnostic phase reports in git (small; evidence for QA.4.0)
!data/output/PhaseQA30_unseen_benchmark/
!data/output/PhaseQA30_unseen_benchmark/**
!data/output/PhaseQA31_pipeline_diagnostics/
!data/output/PhaseQA31_pipeline_diagnostics/**
!data/output/PhaseQA32_ground_truth_crop_validation/
!data/output/PhaseQA32_ground_truth_crop_validation/**
!data/output/PhaseQA33_ownership_explainability/
!data/output/PhaseQA33_ownership_explainability/**
!data/output/PhaseQA34_ownership_competition_validation/
!data/output/PhaseQA34_ownership_competition_validation/**
data/web_runs/**
!data/web_runs/.gitkeep

# Phase M.1 vision dataset runs (large binary assets; regenerated by Phase M.1 runner)
data/vision_dataset/run_*/
!data/vision_dataset/.gitkeep

# Webapp runtime
webapp/logs/**
!webapp/logs/.gitkeep
webapp/uploads/**
!webapp/uploads/.gitkeep
webapp/outputs/**
!webapp/outputs/.gitkeep
