# Steel Beam Estimation Version10 — Hybrid / Claude environment
# Copy to a protected path (recommended):
#   /etc/steel-beam-estimator-v10.env
# chmod 600, owner root (readable by the service user via systemd EnvironmentFile).
#
# NEVER commit a filled copy of this file.
# NEVER put the API key in the repository or in webapp/.env that is synced by git.

# off | shadow | production | authoritative
# authoritative remains defined but DISABLED (W.5/W.6 refuse it)
# production = Vision-preferred semantic authority; engineering stays deterministic
HYBRID_MODE=off

# Required only when HYBRID_MODE=shadow or HYBRID_MODE=production.
# Leave unset for HYBRID_MODE=off.
# ANTHROPIC_API_KEY=

# Optional model override (default: ClaudeConfig.MODEL_NAME in src/llm/claude_config.py)
# HYBRID_CLAUDE_MODEL=claude-sonnet-4-5

# Guardrails
# Production mode defaults: HYBRID_MAX_LIVE_CALLS=0 (unlimited), HYBRID_MAX_WALL_S=0 (no extra wall cap)
# Shadow mode defaults: 6 live calls / 90s wall
# HYBRID_MAX_LIVE_CALLS=0
# HYBRID_MAX_WALL_S=0
HYBRID_PER_CALL_TIMEOUT_S=120

# Optional dotenv path if not using EnvironmentFile for the key
# ANTHROPIC_DOTENV_PATH=
