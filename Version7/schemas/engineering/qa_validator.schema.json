{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QAValidator",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_name", "validation_status", "confidence"],
  "properties": {
    "artifact_name": {
      "type": "string"
    },
    "validation_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "WARN"]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
