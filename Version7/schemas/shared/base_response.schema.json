{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BaseResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "confidence", "message"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["ok", "error", "partial"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "message": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
