# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
*.pem

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Logs and local run artifacts
*.log
*.bak
run_*.txt

# Generated pipeline outputs (regenerated by runners)
data/output/**
!data/output/.gitkeep
data/web_runs/**
!data/web_runs/.gitkeep

# Webapp runtime
webapp/logs/**
!webapp/logs/.gitkeep
webapp/uploads/**
!webapp/uploads/.gitkeep
webapp/outputs/**
!webapp/outputs/.gitkeep
