{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReinforcementParser",
  "type": "object",
  "additionalProperties": false,
  "required": ["beam_id", "annotation_text", "parsed_result", "confidence"],
  "properties": {
    "beam_id": {
      "type": "string"
    },
    "annotation_text": {
      "type": "string"
    },
    "parsed_result": {
      "type": "object",
      "additionalProperties": true
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
