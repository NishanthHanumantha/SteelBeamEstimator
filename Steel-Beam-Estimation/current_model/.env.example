# Steel Beam Estimation — environment template (Phase D.4.2)
# Copy to .env and edit before production start:
#   cp .env.example .env
#
# systemd EnvironmentFile and python-dotenv both read KEY=value lines.
# Do not use "export " prefixes.

FLASK_ENV=production
SECRET_KEY=change-me-to-a-long-random-string

# Absolute path to the estimation engine (must contain Run_PY/).
# Mode B monorepo on Lightsail example:
# STEEL_ENGINE_ROOT=/opt/steel-beam-estimation/SteelBeamEstimator/Version8
#
# Leave unset to auto-discover a sibling Version8 next to Steel-Beam-Estimation/.
# STEEL_ENGINE_ROOT=

STEEL_WEB_MAX_UPLOAD_MB=256

# Keep uploads + web_runs after successful runs (default: clean only on success)
# STEEL_KEEP_WEB_RUNS=1

# Optional: seed R.3 artefacts from a prior offline run
# STEEL_ARTEFACT_SEED_ROOT=
