# Steel Beam Estimation — environment template (Phase D.3)
# Copy to .env and fill in values. Never commit .env or real credentials.

FLASK_ENV=development
SECRET_KEY=
ANTHROPIC_API_KEY=
MAX_UPLOAD_MB=256

# Bind address for local run.py / later process managers
STEEL_BEAM_HOST=127.0.0.1
STEEL_BEAM_PORT=5000

# Absolute path to the active estimation engine (folder with Run_PY/ and src/).
# Leave empty when Run_PY is packaged inside current_model/.
STEEL_ENGINE_ROOT=

# Optional: seed root for missing intermediate artefacts (absolute path)
STEEL_ARTEFACT_SEED_ROOT=
